{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(composer verify)",
      "Bash(composer dump-autoload:*)",
      "Bash(php artisan test:*)",
      "Bash(php artisan make:*)",
      "Bash(php artisan migrate)",
      "Bash(php artisan migrate:status)",
      "Bash(php artisan migrate:rollback:*)",
      "Bash(php artisan migrate:fresh --seed)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan events:sync --dry-run:*)",
      "Bash(./vendor/bin/pest:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "WebFetch(domain:laravel.com)",
      "WebFetch(domain:inertiajs.com)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:pestphp.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:vaul.emilkowal.ski)",
      "WebFetch(domain:radix-ui.com)"
    ],
    "ask": [
      "Read(./node_modules/**)",
      "Read(./vendor/**)",
      "Bash(composer require:*)",
      "Bash(composer remove:*)",
      "Bash(composer update:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(curl:*)",
      "Bash(rm -rf:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.production)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git checkout --:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git update-index:*)",
      "Bash(git apply:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh" }
        ]
      }
    ]
  }
}
